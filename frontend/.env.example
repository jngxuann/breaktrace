# Copy this file to frontend/.env.local and adjust as needed.
# Never commit real values.

# Base URL of the deployed BreakTrace backend.
# Local development uses the default when this is unset:
#   http://localhost:8000
# Production (Vercel) must point at the Render backend URL, e.g.:
#   https://breaktrace-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000