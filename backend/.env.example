# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# Core AI provider setting. Valid values: nosana, groq.
# Controls which inference backend BreakTrace uses for security reasoning.
# Nosana is the intended provider for the final demo; Groq is available for
# faster local development/testing.
AI_PROVIDER=nosana

# Daytona sandbox runner.
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_API_URL=https://app.daytona.io/api
# Optional: target region (e.g. "us"). Defaults to your org's default region.
DAYTONA_TARGET=

# Nosana-hosted Ollama
# The Nosana deployment runs Ollama - fill in your deployment URL and the
# exact model name. Both are read from the environment; never hardcode them
# in code or commit real values.
NOSANA_API_URL=https://your-nosana-ollama-endpoint.example.com
NOSANA_MODEL=qwen3.5:9b

# Groq API (alternative AI provider for development/testing)
# Uses Groq's OpenAI-compatible chat completions endpoint.
# Fill in your API key and model name. Never commit real values.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# Milestone 12 - BreakTrace Regression Demo repository.
# Required for the security_regression_demo target. The demo repo is already
# prepared locally in ../demo_app (three pushed tags: demo-v1-vulnerable,
# demo-v2-fixed, demo-v3-regression). Set this to that PUBLIC repo URL.
# Leave empty if you have not created the repository yet.
BREAKTRACE_DEMO_REPO_URL=

# CORS - deployed frontend origin(s), comma-separated. Local development
# (http://localhost:3000, http://127.0.0.1:3000) is always allowed, so this
# is only needed once you deploy the frontend (e.g. Vercel).
# Example: https://my-breaktrace-demo.vercel.app
FRONTEND_ORIGIN=